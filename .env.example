# Example Environment Variables
# Copy this file to .env.development, .env.staging, or .env.production

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=http://localhost:3000
EXPO_PUBLIC_ENV=development

# Sentry Configuration
# Get your DSN from https://sentry.io/settings/projects/
EXPO_PUBLIC_SENTRY_DSN=

# Certificate Pinning
# Enable certificate pinning (recommended for production only)
EXPO_PUBLIC_CERT_PINNING_ENABLED=false
# Fail requests if no pins configured (recommended for production)
EXPO_PUBLIC_CERT_PINNING_STRICT=false
